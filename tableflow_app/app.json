{
  "expo": {
    "name": "TableFlow",
    "slug": "tableflow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tableflow.app"
    },
    "android": {
      "package": "com.tableflow.app",
      "permissions": []
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:5000/api",
      "eas": {
        "projectId": "91ec7a25-589f-456d-bb59-784e95869517"
      }
    },
    "plugins": [
      "expo-secure-store"
    ],
    "owner": "shyam.dev99"
  }
}
